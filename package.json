{
  "name": "co-scientist",
  "version": "1.0.0",
  "description": "Multi-agent AI system for automated scientific hypothesis generation and ranking \u2014 inspired by the Co-Scientist paper (Gottweis et al., Nature 2026), with significant extensions including Glicko-2 ranking, provenance tracking, knowledge graph, experiment design, and local vector search",
  "type": "module",
  "bin": {
    "co-scientist": "src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "start": "bun run src/cli/index.ts",
    "test": "bun test",
    "build": "bun build src/cli/index.ts --outdir dist --target bun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "handlebars": "^4.7.9",
    "inquirer": "^13.4.3",
    "jsonrepair": "^3.14.0",
    "openai": "^4.104.0",
    "ora": "^8.2.0",
    "p-queue": "^8.1.1",
    "parallel-web": "^0.5.0",
    "sqlite-vec": "^0.1.9",
    "uuid": "^14.0.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
