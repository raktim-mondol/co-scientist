{
  "name": "co-scientist-bun",
  "version": "1.0.0",
  "description": "Multi-agent AI system for automated scientific hypothesis generation and ranking — inspired by the Co-Scientist paper (Gottweis et al., Nature 2026), with significant extensions including Glicko-2 ranking, provenance tracking, knowledge graph, experiment design, and local vector search",
  "type": "module",
  "bin": {
    "co-scientist": "src/cli/index.ts"
  },
  "scripts": {
    "dev":        "bun run src/cli/index.ts",
    "start":      "bun run src/cli/index.ts",
    "test":       "bun test",
    "build":      "bun build src/cli/index.ts --outdir dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "handlebars": "^4.7.8",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "inquirer": "^13.4.3",
    "jsonrepair": "^3.12.0",
    "openai": "^4.52.7",
    "ora": "^8.0.1",
    "p-queue": "^8.0.1",
    "parallel-web": "^0.5.0",
    "react": "^18.3.1",
    "sqlite-vec": "^0.1.9",
    "uuid": "^14.0.0",
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/handlebars": "^4.1.0",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10"
  }
}
