# ─────────────────────────────────────────────
# DeepSeek LLM Configuration
# ─────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ─────────────────────────────────────────────
# MCP Tool Configuration
# ─────────────────────────────────────────────

# Parallel AI Search API (web search) — REST API key
# Generate your key at: https://platform.parallel.ai
PARALLEL_AI_API_KEY=your_parallel_ai_api_key_here

# Consensus MCP (academic search — primary)
# Consensus uses OAuth 2.1 PKCE by default — no API key required.
# On first run, a browser window opens for authorization.
# Tokens are saved to ~/.co-scientist/consensus-oauth.json and auto-refreshed.
CONSENSUS_MCP_URL=https://mcp.consensus.app/mcp
# Optional: Set a static API key to skip the browser OAuth flow entirely.
# Only use this if you have a paid Consensus API key.
# CONSENSUS_API_KEY=your_consensus_api_key_here

# Scite MCP (academic search — fallback)
# Automatically used when Consensus is unavailable. Same OAuth PKCE pattern.
# Tokens saved to ~/.co-scientist/scite-oauth.json.
# SCITE_MCP_URL=https://api.scite.ai/mcp
# Optional: static API key to skip OAuth.
# SCITE_API_KEY=your_scite_api_key_here

# Academic search provider priority (comma-separated, tried in order).
# Default: consensus,scite
# Valid values: consensus, scite
# Examples:
#   ACADEMIC_SEARCH_PROVIDERS=consensus        # Consensus only
#   ACADEMIC_SEARCH_PROVIDERS=scite            # Scite only
#   ACADEMIC_SEARCH_PROVIDERS=scite,consensus  # Scite first, Consensus fallback
#   ACADEMIC_SEARCH_PROVIDERS=consensus,scite  # Consensus first, Scite fallback (default)
#
# Academic search execution mode:
#   priority — try providers in order, first success wins (default)
#   parallel — call all configured providers simultaneously, merge results
#   fallback — try first; only use next if first returns zero results or errors
# ACADEMIC_SEARCH_MODE=priority

# ─────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────
# Default: ~/.co-scientist/co-scientist.db
# Override with absolute path if needed:
# DB_PATH=/absolute/path/to/co-scientist.db

# ─────────────────────────────────────────────
# Compute Budget
# ─────────────────────────────────────────────
MAX_WORKERS=3
MAX_HYPOTHESES=5
MAX_TOURNAMENT_ROUNDS=100
# Max total tokens before session auto-stops (0 = unlimited)
COMPUTE_BUDGET_TOKENS=500000

# ─────────────────────────────────────────────
# Deep Evidence Pipeline (optional)
# ─────────────────────────────────────────────
# Bounded search→plan→read→bank loop grounds literature_exploration
# in actual page content. 0 rounds disables the pipeline entirely.
# DEEP_RESEARCH_MAX_ROUNDS=2
# DEEP_RESEARCH_URLS_PER_ROUND=3
# DEEP_RESEARCH_MAX_CONTENT_CHARS=40000

# ─────────────────────────────────────────────
# Citation Verification (optional)
# ─────────────────────────────────────────────
# Step 2c: Headless Chromium (Playwright) fallback for citation URLs blocked
# by Cloudflare JS challenges (e.g., academic.oup.com, frontiersin.org).
#
# Setup (one-time, ~200MB):
#   1. bun install          # playwright npm package is already in package.json
#   2. npx playwright install chromium   # downloads the browser binary
#   3. Set CITATION_HEADLESS_BROWSER=true below
#
# Without this, Step 2c is skipped entirely — Steps 1–3 still work fine.
# CITATION_HEADLESS_BROWSER=true

# ─────────────────────────────────────────────
# Reproducibility (optional)
# ─────────────────────────────────────────────
# Seeds all scheduling/sampling RNG so runs are reproducible. Unset = normal
# (non-deterministic) runs. With MAX_WORKERS > 1, task-completion order is still
# non-deterministic; set MAX_WORKERS=1 for stricter determinism. CLI flag: --seed <n>
# SEED=42

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
# Options: debug | info | warn | error
LOG_LEVEL=info
